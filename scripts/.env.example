# =============================================================================
# scripts/.env.example
# Bantay Bayan System — Environment Variable Template
# =============================================================================
# COPY this file to .env (for local dev) or add each variable to your
# hosting platform (Vercel / Netlify) environment settings.
#
# DO NOT commit .env or any file containing real credentials to git.
# =============================================================================

# ── Frontend (Vite / React) ────────────────────────────────────────────────
# Supabase project URL (found in: Supabase Dashboard → Project Settings → API)
VITE_SUPABASE_URL=https://<project-ref>.supabase.co

# Supabase anon/public key — safe to use in the browser
# Found in: Supabase Dashboard → Project Settings → API → anon (public)
VITE_SUPABASE_ANON_KEY=<your-anon-key>

# ── Supabase CLI / Edge Functions ─────────────────────────────────────────
# Personal access token for the Supabase CLI
# Generate at: https://app.supabase.com/account/tokens
SUPABASE_ACCESS_TOKEN=<your-access-token>

# Project reference ID (short string, NOT the full URL)
# Found in: Supabase Dashboard → Project Settings → General → Reference ID
SUPABASE_PROJECT_REF=<project-ref>

# Service role key — NEVER expose in frontend/browser code
# Found in: Supabase Dashboard → Project Settings → API → service_role (secret)
# Used only in Edge Functions (server-side) and backup scripts.
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>

# ── Database Backup ────────────────────────────────────────────────────────
# PostgreSQL host for pg_dump (same as Supabase DB host)
# Found in: Supabase Dashboard → Project Settings → Database → Host
SUPABASE_DB_HOST=db.<project-ref>.supabase.co

# PostgreSQL password for the backup user
# Found in: Supabase Dashboard → Project Settings → Database → Database Password
PGPASSWORD=<your-db-password>

# Optional overrides (defaults shown)
# PGPORT=5432
# PGUSER=postgres
# PGDATABASE=postgres

# Directory where pg_dump files are saved (default: ./backup/db)
# BACKUP_DIR=./backup/db

# Number of days to retain backup files before pruning (default: 30)
# BACKUP_RETENTION_DAYS=30

# ── Database Restore ───────────────────────────────────────────────────────
# Only set these when running a restore to a different project/host
# RESTORE_DB_HOST=db.<new-project-ref>.supabase.co
# DUMP_FILE=./backup/db/bantay_bayan_backup_YYYYMMDD_HHMMSS.dump
